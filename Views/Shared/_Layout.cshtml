<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API Intelligence Hub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm dark-navbar mb-0">
            <div class="container">
                @{
                    var navController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var onSecurityPage = string.Equals(navController, "Security", StringComparison.OrdinalIgnoreCase);
                }
                <a class="navbar-brand" asp-controller="ApiAnalyzer" asp-action="Index">API<span class="brand-accent">Intelligence Hub</span></a>
                <ul class="navbar-nav flex-row gap-3">
                    <li class="nav-item">
                        @if (onSecurityPage)
                        {
                            <a class="nav-link nav-link--security" asp-controller="ApiAnalyzer" asp-action="Index">
                                <span class="nav-link__icon" aria-hidden="true">📊</span> Dashboard
                            </a>
                        }
                        else
                        {
                            <a class="nav-link nav-link--security" asp-controller="Security" asp-action="Index">
                                <span class="nav-link__icon" aria-hidden="true">🛡</span> Security Audit
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer dark-footer text-muted">
        <div class="container">
            &copy; 2026 - API Intelligence Hub
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
